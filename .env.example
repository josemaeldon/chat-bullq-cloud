# Copie este arquivo para `.env` e substitua todos os valores CHANGE_ME.
# O arquivo `.env` real e ignorado pelo Git e nao deve ser versionado.

# Unica URL publica da plataforma.
# Local:    http://localhost:3000
# Producao: https://app.seudominio.com
#
# API, uploads, Socket.IO e webhooks usam esta mesma origem. Internamente,
# o frontend encaminha as requisicoes para http://backend:3001.
PUBLIC_URL=http://localhost:3000

# Portas publicadas no host
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PUBLIC_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL
POSTGRES_USER=chat_bullq
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=chat_bullq
# Deve corresponder aos tres valores acima. Codifique caracteres especiais da senha para URL.
DATABASE_URL=postgresql://chat_bullq:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/chat_bullq

# Autenticacao: gere dois valores diferentes.
# Exemplo: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis: deixe vazio enquanto a stack usar Redis sem senha.
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=chat_bullq
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=chat-bullq

# IA: opcional. Sem esta chave, recursos dependentes de OpenAI ficam indisponiveis.
OPENAI_API_KEY=

# Web Push: opcionais
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@seudominio.com
