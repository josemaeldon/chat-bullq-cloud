# Copie este arquivo para `.env` e substitua todos os valores CHANGE_ME.
# O arquivo `.env` real e ignorado pelo Git e nao deve ser versionado.

# Unica URL publica da plataforma.
# Local:    http://localhost:3000
# Producao: https://app.seudominio.com
#
# API, uploads, Socket.IO e webhooks usam esta mesma origem. Internamente,
# o frontend encaminha as requisicoes para http://backend:3001.
PUBLIC_URL=http://localhost:3000

# Imagens prontas publicadas pelo GitHub Actions.
# Para fixar uma versao, troque `latest` por `v1.0.0` ou `sha-abcdef0`.
BACKEND_IMAGE=ghcr.io/josemaeldon/chat-bullq-cloud-backend:latest
FRONTEND_IMAGE=ghcr.io/josemaeldon/chat-bullq-cloud-frontend:latest

# Rede Docker exclusiva da stack. Use outro nome apenas se ja existir uma rede
# com esse nome no servidor.
DOCKER_NETWORK_NAME=chat-bullq-cloud-internal

# Unica porta publicada no host
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_USER=chat_bullq
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=chat_bullq
# Deve corresponder aos tres valores acima. Codifique caracteres especiais da senha para URL.
DATABASE_URL=postgresql://chat_bullq:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/chat_bullq

# Autenticacao: gere dois valores diferentes.
# Exemplo: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis: deixe vazio enquanto a stack usar Redis sem senha.
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=chat_bullq
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=chat-bullq

# IA: opcional. Sem esta chave, recursos dependentes de OpenAI ficam indisponiveis.
OPENAI_API_KEY=

# Recuperacao de senha por SMTP
# Porta 587 normalmente usa SMTP_SECURE=false (STARTTLS).
# Porta 465 normalmente usa SMTP_SECURE=true.
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=Chat BullQ <nao-responda@seudominio.com>

# Web Push: opcionais
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@seudominio.com
